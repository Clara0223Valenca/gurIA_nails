# Configure estes valores para uso local. Não coloque chaves reais no repositório.
MYSQL_DATABASE=guria_nails
MYSQL_USER=guria
MYSQL_PASSWORD=troque-esta-senha-local
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PORT=3306
DB_URL=jdbc:mariadb://127.0.0.1:3306/guria_nails
DB_USER=guria
DB_PASSWORD=troque-esta-senha-local
# Em produção, use um usuário separado com permissões DDL para o Flyway.
DB_MIGRATION_USER=guria_migrator
DB_MIGRATION_PASSWORD=troque-esta-senha-migrator
DB_POOL_SIZE=8
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
GURIA_FRONTEND_PORT=4173
GURIA_FRONTEND_HOST=127.0.0.1
GURIA_FRONTEND_ORIGIN=http://127.0.0.1:4173
GURIA_API_BASE_URL=http://localhost:8080/api

# Modo Evento. Defina GURIA_EVENT_CODE também no ambiente do Render; nunca no JavaScript.
GURIA_EVENT_CODE=GURIA26
GURIA_EVENT_ACCESS_TTL=PT24H
GURIA_EVENT_AI_LIMIT=10
GURIA_EVENT_PROJECT_LIMIT=20

# RunPod Serverless exige Endpoint ID e uma API Key mantida somente no backend.
GURIA_AI_PROVIDER=runpod
GURIA_AI_BASE_URL=https://api.runpod.ai/v2
GURIA_AI_API_KEY=
GURIA_AI_ENDPOINT_ID=a5v1by47re8fd3
GURIA_AI_MODEL=black-forest-labs/FLUX.2-klein-4B
GURIA_AI_MAX_WAIT_SECONDS=600
# Paths usados somente com GURIA_AI_PROVIDER=http (provider próprio/compatível).
GURIA_AI_GENERATE_PATH=/generate
GURIA_AI_IMPROVE_PATH=/improve
